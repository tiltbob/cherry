config BR2_PACKAGE_OPENCODE
	bool "opencode"
	# Upstream's prebuilt x86_64 binary, linked against glibc.
	depends on BR2_x86_64
	depends on BR2_TOOLCHAIN_USES_GLIBC
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_BUSYBOX_SHOW_OTHERS # bash
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS # ripgrep
	select BR2_PACKAGE_BASH # the shell of its bash tool
	select BR2_PACKAGE_RIPGREP # its grep, glob and file search tools
	help
	  OpenCode, an AI coding agent: the opencode command, with its
	  server (`opencode serve`: the HTTP API and web UI) and its
	  clients. Just the binary; see below for running the server
	  as a service.

	  Upstream's prebuilt binary for x86_64: the "baseline" build,
	  which doesn't need AVX2, so it runs on any x86_64 machine or
	  VM CPU model. It is a Bun single-file executable, and strip
	  breaks it: BR2_STRIP_EXCLUDE_FILES must list opencode.

	  https://opencode.ai

if BR2_PACKAGE_OPENCODE

config BR2_PACKAGE_OPENCODE_SERVICE
	bool "opencode.service"
	help
	  Run the server as a system service: the opencode user, with
	  /var/lib/opencode as its home, and opencode.service, which
	  runs `opencode serve` as that user, listening on
	  127.0.0.1:4096 only, with its state (sessions, provider
	  credentials, logs) under /var/lib/opencode and a password
	  for the boot in /var/lib/opencode/server-password. Clients
	  reach it over SSH port forwarding.

endif
