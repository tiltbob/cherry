[Unit]
Description=OpenChamber Server
Documentation=https://github.com/openchamber/openchamber
After=network.target

[Service]
Type=exec
User=openchamber
Group=openchamber
# Its home: OpenChamber keeps its data in .config/openchamber under it, and so
# does the OpenCode it runs. The agent works in work/ unless a project picks
# another directory. /var is a tmpfs for now, so all of it is new at every boot.
StateDirectory=openchamber openchamber/work
Environment=HOME=/var/lib/openchamber
WorkingDirectory=/var/lib/openchamber/work
Environment=OPENCODE_BINARY=/usr/bin/opencode
Environment=BUN_BINARY=/usr/bin/bun
# Loopback only, both: OpenChamber on 127.0.0.1:3000 (openchamber-serve), and
# the OpenCode it runs on 127.0.0.1 and a free port. Neither can listen on a
# Unix socket.
Environment=OPENCHAMBER_OPENCODE_HOSTNAME=127.0.0.1
# The image is read-only: a new version comes with a new image. No update
# checks, and `openchamber update` says that updates are disabled (Cherry's
# patch to OpenChamber); OpenCode's own are off too.
Environment=OPENCODE_DISABLE_AUTOUPDATE=1
# For its terminals: bash's line editing handles multibyte characters.
Environment=LANG=C.UTF-8
# The browser UI's password, if the machine was given one (SMBIOS strings,
# see scripts/run_qemu.py --credential).
ImportCredential=openchamber.ui_password
ExecStart=/usr/libexec/openchamber-serve
# Also after a clean exit: `openchamber stop` or `restart` from a shell end the
# server through its API, and it should come back.
Restart=always

# Hardening, as for ipfs.service. Its terminals and tools, and the agent's, run
# as the openchamber user inside it: they see the system read-only, except
# /var/lib/openchamber and a private /tmp. No MemoryDenyWriteExecute: Bun's
# JavaScript JIT needs that.
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
DevicePolicy=closed
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# Terminals run arbitrary commands: a filtered system call fails with EPERM,
# as it would for any unprivileged process, rather than kill the process.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
