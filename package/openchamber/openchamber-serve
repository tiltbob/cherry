#!/bin/sh
# Run OpenChamber's server in the foreground, for a systemd unit:
# openchamber.service, or another package's (Cherry's cherry.service).
#
# Loopback only, port 3000: neither OpenChamber nor OpenCode can listen on a
# Unix socket, and the unit keeps the OpenCode it runs on loopback too
# (OPENCHAMBER_OPENCODE_HOSTNAME). Reach it through SSH port forwarding, or
# from another device through the relay of a pairing link. The browser UI gets
# a password only if the machine was given one as the systemd credential
# openchamber.ui_password (e.g. with --credential of scripts/run_qemu.py).
set -eu

if [ -n "${CREDENTIALS_DIRECTORY:-}" ] && [ -s "$CREDENTIALS_DIRECTORY/openchamber.ui_password" ]; then
	OPENCHAMBER_UI_PASSWORD=$(cat "$CREDENTIALS_DIRECTORY/openchamber.ui_password")
	export OPENCHAMBER_UI_PASSWORD
fi

exec /usr/bin/openchamber serve --foreground --host 127.0.0.1 --port 3000
