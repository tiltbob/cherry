#!/bin/sh
# cherry-bootstrap@.service: create a container in /var/lib/machines, as root,
# for the cherry user, which may start this unit but not run the bootstrap tools
# itself. The instance names the distribution, its release and the machine,
# separated by colons, and the README's command for each tool does the rest:
#
#   systemctl start cherry-bootstrap@debian:trixie:mybox   # debootstrap
#   systemctl start cherry-bootstrap@ubuntu:noble:mybox    # debootstrap, Ubuntu's keyring and archive
#   systemctl start cherry-bootstrap@fedora:44:mybox       # rpmstrap, any profile
#   systemctl start cherry-bootstrap@arch::mybox           # pacstrap
#   machinectl start mybox
#
# The output goes to $LOGS_DIRECTORY/<instance>.log, which the cherry user can
# read; without LOGS_DIRECTORY, to stdout (cherry-image, which logs it itself).
# A failed bootstrap leaves no tree behind. On btrfs (/var on the machine's
# disk), the tree is a subvolume: machinectl clone then snapshots it, so an
# environment takes space only for what it changes, and machinectl remove
# drops it at once. $CHERRY_MACHINES_DIR replaces /var/lib/machines
# (cherry-image, tests/bootstrap.sh).
set -eu

machines=${CHERRY_MACHINES_DIR:-/var/lib/machines}
instance=$1
IFS=: read -r distro release name <<EOF2
$instance
EOF2

case $name in
'' | .* | *[!A-Za-z0-9_.-]*)
	echo "bad machine name '$name': letters, digits, '.', '_' and '-', not starting with '.'" >&2
	exit 1 ;;
esac
for part in "$distro" "$release"; do
	case $part in
	-* | *[!A-Za-z0-9_.-]*)
		echo "bad distribution or release '$part': letters, digits, '.', '_' and '-', not starting with '-'" >&2
		exit 1 ;;
	esac
done
if [ "$distro" = arch ] && [ -n "$release" ]; then
	echo "Arch Linux has no release: use arch::$name" >&2
	exit 1
fi
dir=$machines/$name
if [ -e "$dir" ]; then
	echo "$dir exists" >&2
	exit 1
fi

if [ -n "${LOGS_DIRECTORY:-}" ]; then
	log=$LOGS_DIRECTORY/$instance.log
	echo "bootstrapping $dir, log in $log"
	exec >"$log" 2>&1
else
	echo "bootstrapping $dir"
fi
trap 'rm -rf "$dir"' EXIT
# A subvolume on btrfs (rm -rf removes an empty one too); elsewhere, the tool
# makes the directory.
if [ "$(stat -f -c %T "$machines")" = btrfs ]; then
	btrfs subvolume create "$dir"
fi

case $distro in
debian)
	debootstrap --variant=minbase --include=systemd,systemd-sysv,dbus "$release" "$dir" ;;
ubuntu)
	debootstrap --variant=minbase --include=systemd,systemd-sysv,dbus \
		--keyring=/usr/share/keyrings/ubuntu-archive-keyring.gpg "$release" "$dir" http://archive.ubuntu.com/ubuntu ;;
arch)
	systemctl start pacman-init.service
	mkdir -p "$dir"
	pacstrap -K -c "$dir" base
	rm -rf /var/cache/pacman/pkg/* ;;
*)
	rpmstrap "$distro" "$release" "$dir" ;;
esac

trap - EXIT
[ -z "${LOGS_DIRECTORY:-}" ] || echo "done: machinectl start $name"
