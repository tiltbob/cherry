# /var is the volume var of the pool cherry, the machine's own: on the disks
# the agent claimed, or in RAM until it has any (see
# /usr/libexec/cherry-storage). var.mount pulls this in and starts after it
# (the overlay's var.mount.d/10-cherry.conf): when this mounted var on /var,
# var.mount finds it mounted; otherwise it mounts its tmpfs.
[Unit]
Description=Cherry /var from the Pool
Documentation=https://github.com/tiltbob/cherry#disks
DefaultDependencies=no
# Only with a usable TPM (see /init), which holds the disks' keys.
ConditionPathExists=/run/cherry/identity/ek-hash
# The disks as udev set them up at boot, and the TPM with its storage key, as
# systemd-repart.service waits for it.
After=systemd-udev-trigger.service tpm2.target systemd-tpm2-setup-early.service
Before=var.mount
# At shutdown, stopped once var.mount has unmounted /var: deactivates the
# pools and closes the disks.
Conflicts=umount.target
Before=umount.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/cherry-storage boot var start
ExecStop=-/usr/libexec/cherry-storage boot var stop
# The disks unlocked with the TPM, one by one, and the pool activated.
TimeoutStartSec=5min
