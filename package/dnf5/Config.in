config BR2_PACKAGE_DNF5
	bool "dnf5"
	depends on !BR2_PACKAGE_LIBSOLV # libsolv-rpm
	depends on !BR2_PACKAGE_RPM # rpm6
	depends on BR2_INSTALL_LIBSTDCPP # C++20
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_11 # C++20
	depends on !BR2_STATIC_LIBS # rpm6
	depends on BR2_TOOLCHAIN_HAS_THREADS # rpm6, libglib2
	depends on BR2_USE_MMU # rpm6, libglib2
	depends on BR2_USE_WCHAR # rpm6, libglib2
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS # rpm-sequoia
	depends on BR2_PACKAGE_LUA && !BR2_PACKAGE_LUA_5_1 # rpm6
	select BR2_PACKAGE_FMT
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBREPO
	select BR2_PACKAGE_LIBSOLV_RPM
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_RPM6
	select BR2_PACKAGE_SQLITE
	select BR2_PACKAGE_TOML11
	select BR2_PACKAGE_UTIL_LINUX
	select BR2_PACKAGE_UTIL_LINUX_LIBSMARTCOLS
	help
	  The dnf5 package manager, with /usr/bin/dnf linking to it as
	  on Fedora. On Cherry it installs RPM-based distributions into
	  a directory (dnf5 --installroot; see rpmstrap), not onto the
	  host.

	  Built without the D-Bus daemon, the CLI plugins,
	  modularity (EL8 modules), bindings and documentation.

	  https://github.com/rpm-software-management/dnf5

comment "dnf5 needs a toolchain w/ C++, wchar, threads, dynamic library, gcc >= 11, and lua >= 5.3"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_USE_MMU
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_GCC_AT_LEAST_11 || \
		BR2_STATIC_LIBS || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_USE_WCHAR || !BR2_PACKAGE_LUA || BR2_PACKAGE_LUA_5_1
