# Fedora Linux, 41 and later
# As in systemd-nspawn(1): enough to boot, log in and run dnf. Plus dbus,
# which machinectl shell and systemctl -M need in the container: Fedora's
# systemd only recommends it, and weak dependencies are off.
packages=(fedora-release systemd systemd-networkd dbus passwd dnf5 util-linux vim-minimal)
dbpath=/usr/lib/sysimage/rpm
