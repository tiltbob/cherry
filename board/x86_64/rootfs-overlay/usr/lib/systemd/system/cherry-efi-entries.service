[Unit]
Description=Cherry: ensure UEFI boot entries for both slots
Documentation=file:/usr/lib/cherry/efi-entries
ConditionFirmware=uefi
ConditionVirtualization=!container
Requires=dev-disk-by\x2dpartlabel-cherry\x2defi\x2da.device dev-disk-by\x2dpartlabel-cherry\x2defi\x2db.device
After=dev-disk-by\x2dpartlabel-cherry\x2defi\x2da.device dev-disk-by\x2dpartlabel-cherry\x2defi\x2db.device
Before=rauc.service cherry-health.service cherry-mark-good.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/cherry/efi-entries

[Install]
WantedBy=multi-user.target
