# /var on the machine's encrypted disk, a LUKS2 volume whose key the TPM seals,
# made on the first blank disk if there is none yet: see /usr/lib/cherry/var.
# var.mount pulls this in and starts after it (var.mount.d/10-cherry.conf):
# when this mounted the disk on /var, var.mount finds it mounted; otherwise it
# mounts its tmpfs.
[Unit]
Description=Cherry /var on an Encrypted Disk
Documentation=https://github.com/tiltbob/cherry#disks
DefaultDependencies=no
# Only with a usable TPM (see /init), which holds the key.
ConditionPathExists=/run/cherry/identity/ek-hash
# The disks as udev set them up at boot, and the TPM with its storage key, as
# systemd-repart.service waits for it.
After=systemd-udev-trigger.service tpm2.target systemd-tpm2-setup-early.service
Before=var.mount
# At shutdown, stopped once var.mount has unmounted /var: closes the volume.
Conflicts=umount.target
Before=umount.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/cherry/var
ExecStop=-/usr/bin/systemd-cryptsetup detach cherry-var
# Making the disk partitions, encrypts and formats it.
TimeoutStartSec=10min
