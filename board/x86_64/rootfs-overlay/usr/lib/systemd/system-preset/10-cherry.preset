# Sorts before systemd's 90-systemd.preset; the first match wins.
# Nothing may pull in network-online.target on a container host without links.
disable systemd-networkd-wait-online.service
# systemd-boot is only built for its UKI stub.
disable systemd-boot-update.service
# systemd-pcrlock rebuilds a local PCR policy from the firmware's event log at
# every boot and stores it in TPM NV memory. Cherry's secrets will be bound to a
# PCR policy signed at build time instead.
disable systemd-pcrlock-*
# lvm2's own units, there for cherry-storage's pools: no dmeventd, as
# /etc/lvm/lvm.conf monitors nothing, and no devices file, which it does not
# use (the import would write it to /etc, which is read-only). No
# blk-availability.service either: its blkdeactivate would unmount and close
# device-mapper devices at shutdown, /var's among them, out of turn;
# cherry-storage.service and cherry-var.service close theirs in order.
disable dm-event.socket
disable lvm2-monitor.service
disable lvm-devices-import.path
disable lvm-devices-import.service
disable blk-availability.service
