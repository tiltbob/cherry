#!/bin/sh
# RAUC pre-install handler: a non-zero exit aborts `rauc install` before any
# slot is touched. Only install from a healthy, confirmed slot on this disk.
set -eu
. /usr/lib/cherry/lib.sh

systemctl -q is-active cherry-health.service ||
	die "refusing to install: this boot did not pass cherry-health.service"

slot=$(cmdline_slot) || die "refusing to install: cannot tell which slot is booted"
efi_refresh
n=$(efi_nums "cherry-$slot" | head -n 1)
{ [ -n "$n" ] && efi_in_bootorder "$n"; } ||
	die "refusing to install: the booted slot cherry-$slot is not confirmed good yet"

disk=$(root_disk)
for p in cherry-efi-a cherry-efi-b cherry-root-a cherry-root-b; do
	dev=$(readlink -f "/dev/disk/by-partlabel/$p")
	parent=$(basename "$(readlink -f "/sys/class/block/${dev##*/}/..")")
	[ "$parent" = "$disk" ] || die "refusing to install: $p is $dev, not on /dev/$disk"
done
