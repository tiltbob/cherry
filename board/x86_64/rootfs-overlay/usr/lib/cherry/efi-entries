#!/bin/sh
# Ensure the firmware has exactly one well-formed boot entry per slot:
# "cherry-X" -> \EFI\cherry\cherry-X.efi on partition cherry-efi-X, without load
# options. RAUC's efi backend switches slots through these entries (matched by
# label) but never creates them, so this runs on every boot: after the first
# boot of a freshly flashed disk, after NVRAM loss, or after the firmware
# dropped an entry.
#
# RAUC keeps its slot state in BootOrder (listed = good), so this script never
# touches BootNext, and only writes BootOrder if the variable does not exist.
set -eu
. /usr/lib/cherry/lib.sh

disk=$(root_disk)
efi_refresh
current=$(efi_bootcurrent)

for s in $CHERRY_SLOTS; do
	label=cherry-$s
	part=$(part_by_name "cherry-efi-$s") || die "no cherry-efi-$s partition on /dev/$disk"
	num=$(part_num "$part")
	uuid=$(part_uuid "$part")

	# Keep the entry we booted from (deleting it would confuse RAUC), else the
	# first well-formed one.
	keep=
	if [ -n "$current" ] && [ "$(efi_label "$current")" = "$label" ]; then
		keep=$current
	else
		for n in $(efi_nums "$label"); do
			if efi_entry_ok "$n" "$num" "$uuid" "$s"; then
				keep=$n
				break
			fi
		done
	fi

	for n in $(efi_nums "$label"); do
		[ "$n" = "$keep" ] && continue
		printf 'removing stale or duplicate entry Boot%s (%s: %s)\n' "$n" "$label" "$(efi_path "$n")"
		efibootmgr -q -b "$n" -B
	done

	if [ -z "$keep" ]; then
		printf 'creating %s -> /dev/%s \\EFI\\cherry\\%s.efi\n' "$label" "$part" "$label"
		# -C: create without adding to BootOrder (RAUC decides what is good).
		# No extra arguments: an entry without load options.
		efibootmgr -q -C -d "/dev/$disk" -p "$num" -L "$label" -l "\\EFI\\cherry\\$label.efi"
	fi
done

efi_refresh
if ! efi_has_bootorder; then
	slot=$(cmdline_slot) || die "no BootOrder and no rauc.slot= to seed it from"
	n=$(efi_nums "cherry-$slot" | head -n 1)
	echo "BootOrder does not exist, creating it with Boot$n (cherry-$slot)"
	efibootmgr -q -o "$n"
fi

efibootmgr
