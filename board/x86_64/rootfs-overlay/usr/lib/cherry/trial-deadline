#!/bin/sh
# Fired by cherry-trial-deadline.timer. If this is still an unconfirmed trial
# boot (entered through BootNext after `rauc install`, so the entry is not in
# BootOrder) the new slot never became healthy: reboot so the firmware falls
# back to BootOrder, i.e. the previous slot. On a confirmed slot, or on a
# removable-media fallback boot, this does nothing, so it cannot loop.
set -eu
. /usr/lib/cherry/lib.sh

efi_refresh
current=$(efi_bootcurrent)
[ -n "$current" ] || exit 0
label=$(efi_label "$current")
case "$label" in
cherry-a | cherry-b) ;;
*) exit 0 ;;
esac
efi_in_bootorder "$current" && exit 0

echo "trial boot of $label did not complete in time, rebooting to fall back" >&2
systemctl --no-block reboot
