# Cherry kernel configuration, applied on top of arch/x86/configs/x86_64_defconfig.
# check-kconfig.sh fails the build if any line below does not survive into the
# final .config, so only list symbols that are valid for this kernel version.

# x86_64_defconfig turns this on; it would make toolchain upgrades fragile.
# CONFIG_WERROR is not set

# Direct UEFI (HTTP) boot of a UKI. Its initramfs holds cherry-pit and the root
# filesystem, a zstd-compressed EROFS image that cherry-pit mounts straight from
# the file. The kernel command line is embedded in the UKI.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_PANIC_TIMEOUT=10
CONFIG_DEVTMPFS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Local storage, for containers on disks later.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y

# Network interfaces commonly found on servers and VMs.
CONFIG_VIRTIO_NET=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y

# Filesystems for containers and their images, and for disks: btrfs for /var,
# the pool cherry's volume var (cherry-storage.service), where an environment
# is a snapshot of its image (machinectl clone) and takes space only for what
# it changes, and for the storage volumes (cherry-storage); ext4 to mount a
# volume from elsewhere, which nothing on Cherry makes or manages.
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_OVERLAY_FS=y
CONFIG_AUTOFS_FS=y

# systemd and systemd-nspawn: namespaces, cgroup v2 controllers, BPF device policy.
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_PSI=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP_FILTER=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DMI_SYSFS=y

# Landlock: pacman 7 inside Arch containers sandboxes downloads with it
# (DownloadUser=alpm); CONFIG_LSM already lists landlock.
CONFIG_SECURITY_LANDLOCK=y

# Container networking.
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_TUN=y

# nftables, as used by systemd-networkd IPMasquerade= for nspawn veth/zones,
# and by the firewall (/usr/lib/cherry/firewall.nft), which lets replies in by
# connection tracking. Without bridge netfilter, a zone's bridge switches
# packets between its containers without the firewall's forward chain.
CONFIG_NF_CONNTRACK=y
# CONFIG_BRIDGE_NETFILTER is not set
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y

# Watchdog (i6300esb is QEMU's) for systemd RuntimeWatchdogSec, and entropy.
CONFIG_WATCHDOG=y
CONFIG_I6300ESB_WDT=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# TPM 2.0, mandatory: the machine's identity comes from its endorsement key.
# TIS for discrete TPMs and QEMU's tpm-tis, CRB for firmware TPMs (Intel PTT,
# AMD fTPM) and QEMU's tpm-crb.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
# securityfs, where the firmware's TPM event log shows (/sys/kernel/security/
# tpm0/binary_bios_measurements): cherry-secureboot finds the option ROMs to
# enroll in it. TCG_TPM only implies it, and x86_64_defconfig leaves it off.
CONFIG_SECURITYFS=y

# The claimed disks, LUKS2 volumes whose keys the TPM seals, /var's pool among
# them (cherry-storage): dm-crypt
# with LUKS2's cipher, aes-xts-plain64, on AES-NI or else the generic AES and
# XTS. cryptsetup reaches the kernel's ciphers from user space (AF_ALG) for
# the LUKS2 key slots.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# Storage pools (cherry-storage): LVM volume groups of claimed disks, each a
# LUKS2 volume like /var's. Volumes are linear LVs; on a pool with SSDs, each
# is cached on them (dm-cache, its smq policy, which also flushes a writeback
# cache before it is detached). pvmove, which moves a disk's data off before
# it leaves a pool, mirrors it (dm-mirror).
CONFIG_DM_CACHE=y
CONFIG_DM_CACHE_SMQ=y
CONFIG_DM_MIRROR=y

# Compressed swap in RAM (cherry-zram-swap.service). Everything, the root
# filesystem and /var included, is in RAM; under memory pressure, the kernel
# compresses cold pages, tmpfs ones too, into /dev/zram0 with zstd. A second
# zram device holds the pool cherry, and so /var, until the pool has disks
# (cherry-storage.service).
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
